---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="wrap">
    <header class="pagehead">
      <span class="kick">404</span>
      <h1 class="hed" style="margin-top:10px">This page took a different path.</h1>
      <p class="dek">It may have moved. Try the homepage or search.</p>
      <div class="share" style="margin-top:28px"><a href="/">Homepage</a><a href="/search/">Search</a></div>
    </header>
  </div>
</Base>
