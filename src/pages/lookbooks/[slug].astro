---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import ProductCard from '../../components/ProductCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { settings } from '../../lib/settings';
import { getLookbooks, getProductMap, pickProducts, formatDate, lookbookUrl } from '../../lib/content';

export async function getStaticPaths() {
  return (await getLookbooks()).map((l) => ({ params: { slug: l.id }, props: { lb: l } }));
}
const { lb } = Astro.props;
const d = lb.data;
const { Content } = await render(lb);
const map = await getProductMap();
const spots = d.hotspots.map((h) => ({ ...h, p: map.get(h.product) })).filter((h) => h.p);
const spotIds = new Set(spots.map((s) => s.p!.id));
const extra = pickProducts(d.products, map).filter((p) => !spotIds.has(p.id));
const all = [...spots.map((s) => s.p!), ...extra];
const url = new URL(lookbookUrl(lb), Astro.site).href;
---
<Base title={d.seo?.title || d.title} description={d.seo?.description || d.excerpt} image={d.pin_image || d.room_photo} type="article" published={d.date}>
  <div class="wrap">
    <header class="article-head">
      <a class="kick" href="/lookbooks/">Lookbook</a>
      <h1 class="hed">{d.title}</h1>
      {d.excerpt && <p class="dek">{d.excerpt}</p>}
      <p class="meta byline"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></p>
      <div class="share">
        <a href={`https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&description=${encodeURIComponent(d.title)}`} target="_blank" rel="noopener">Pin it</a>
        <button type="button" data-copy={url}>Copy link</button>
      </div>
    </header>
    <section class="section lookbook" style="margin-top:40px">
      <div class="room">
        <Img src={d.room_photo} alt={d.room_photo_alt || ''} ratio="45" eager sizes="(max-width: 760px) 100vw, 600px" />
        {spots.map((h, i) => <a class="spot" style={`left:${h.x}%;top:${h.y}%`} href={h.p!.data.link} rel="sponsored noopener" target="_blank" aria-label={`${i + 1}: ${h.p!.data.name} at ${h.p!.data.retailer}`}>{i + 1}</a>)}
      </div>
      <div>
        <p class="disclosure-top">{settings.disclosures.affiliate}</p>
        <ol class="shoplist">
          {spots.map((h, i) => <li><span>{i + 1} · {h.p!.data.name}</span><a href={h.p!.data.link} rel="sponsored noopener" target="_blank">{h.p!.data.retailer} →</a></li>)}
          {extra.map((p) => <li><span>{p.data.name}</span><a href={p.data.link} rel="sponsored noopener" target="_blank">{p.data.retailer} →</a></li>)}
        </ol>
      </div>
    </section>
    <div class="prose"><Content /></div>
    {all.length > 0 && (
      <section class="section band">
        <div class="band-head"><div><span class="kick">Shop the room</span><h2 class="hed">Every piece</h2></div></div>
        <div class="products">{all.map((p) => <ProductCard product={p} />)}</div>
        <p class="disclosure">{settings.disclosures.affiliate}</p>
      </section>
    )}
    <Newsletter />
  </div>
</Base>
