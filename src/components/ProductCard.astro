---
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';

interface Props { product: CollectionEntry<'products'>; }
const p = Astro.props.product.data;
---
<a class="pcard" href={p.link} rel="sponsored noopener" target="_blank">
  <Img src={p.image} alt={p.image_alt || p.name} ratio="11" widths={[200, 320, 480]} sizes="(max-width: 760px) 45vw, 200px" />
  <p class="retailer">{p.retailer}</p>
  <p class="name">{p.name}</p>
  {p.price_note && <p class="note">{p.price_note}</p>}
  <p class="cta">Shop now <span aria-hidden="true">→</span><span class="sr-only"> at {p.retailer} (opens in a new tab)</span></p>
</a>
